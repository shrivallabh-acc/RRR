{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pip install -e:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [],
    "ask": []
  },
  "env": {
    "PYTHONUTF8": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$d=[Console]::In.ReadToEnd()|ConvertFrom-Json;$f=$d.tool_input.file_path;if($f-and$f.EndsWith('.py')){& .venv/Scripts/ruff.exe check $f}",
            "shell": "powershell",
            "statusMessage": "ruff check"
          }
        ]
      }
    ]
  }
}
