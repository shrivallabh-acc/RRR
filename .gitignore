# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / type / lint caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local runtime artifacts (local-first persistence — never committed)
*.sqlite
*.sqlite3
*.db
chroma/
.chroma/
data/local/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Captured test/tool output — transient, never committed
pytest_err.txt
pytest_out.txt

# Secrets — never commit (Phase 2 ClaudeProvider only)
.env
*.key

# Client data — keep local, never commit to any remote
input/
brain/
reports/
configs/osm.yaml
configs/bedrock.yaml
configs/claude.yaml

# AI assistant workspace config — local tooling only
.claude/

# CI/CD pipeline — excluded until explicitly re-enabled
.github/
